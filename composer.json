{
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "azepo/rgaa-check": "@dev",
        "league/commonmark": "^2.10",
        "masterminds/html5": "^2.11",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/filesystem": "7.4.*",
        "symfony/finder": "7.4.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/",
            "Azepo\\RgaaCheck\\Tests\\": "packages/rgaa-check/tests/",
            "Azepo\\RgaaCheckBehat\\Tests\\": "packages/rgaa-check-behat/tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "build": "@php bin/console site:build",
        "check": "@php bin/console site:check",
        "test": "phpunit",
        "stan": "phpstan analyse --no-progress",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "qualite": [
            "@cs",
            "@stan",
            "@test"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    },
    "require-dev": {
        "azepo/rgaa-check-behat": "@dev",
        "behat/behat": "^3.34",
        "behat/mink-browserkit-driver": "^2.3",
        "dmore/behat-chrome-extension": "^1.5",
        "dmore/chrome-mink-driver": "^2.11",
        "friends-of-behat/mink-extension": "^2.7",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.4",
        "symfony/http-client": "7.4.*"
    },
    "description": "Générateur de site statique accessible : Markdown, Twig et contrôles RGAA 4.1 à chaque génération",
    "repositories": [
        {
            "type": "path",
            "url": "packages/rgaa-check"
        },
        {
            "type": "path",
            "url": "packages/rgaa-check-behat"
        }
    ],
    "name": "azepo/generateur-site-statique"
}
